{
  "name": "roman-numerals-converter",
  "version": "0.0.1",
  "description": "Convert numbers to Roman numerals and back, with strict validation.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "roman",
    "roman-numerals",
    "numerals",
    "converter",
    "typescript"
  ],
  "author": "razorftw <walker@ryandoesdev.com> (https://www.ryandoesdev.com/)",
  "contributors": [
    "Khaogamermain01 <khao@khaodoes.dev> (https://www.khaodoes.dev/)"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.8"
  }
}
